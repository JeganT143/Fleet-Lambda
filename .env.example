# Copy to .env (`cp .env.example .env`) and change the passwords.
# .env is git-ignored. Never commit real secrets.

# ---------- PostgreSQL (application database) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me-fleet

# ---------- PostgreSQL (Airflow metadata database, same server) ----------
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow

# ---------- Airflow web UI login ----------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-admin
# Flask session secret for the Airflow web UI (any long random string)
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-airflow-secret
# Optional: encrypts Airflow connections/variables. Generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=vehicle.telemetry
KAFKA_TOPIC_PARTITIONS=3

# ---------- Simulation ----------
# 1 simulated business day = SIM_DAY_REAL_SECONDS real seconds (300 s = 5 min)
SIM_DAY_REAL_SECONDS=300
# The simulation starts at 00:00 Sri Lanka time (Asia/Colombo) on this date
SIM_START_DATE=2026-01-01
FLEET_SIZE=20
# Real seconds between producer ticks (each vehicle emits one event per tick)
STREAM_INTERVAL_SECONDS=1.0
SIM_RANDOM_SEED=42
# Share of EXTRA deliberately-invalid records the producer injects (malformed JSON,
# negative speed, unknown status) so the quarantine path is demonstrable. 0 disables.
PRODUCER_INVALID_EVENT_RATE=0.005
# Real seconds between producer stats log lines
PRODUCER_STATS_INTERVAL_SECONDS=30

# ---------- Streaming ----------
# Window / watermark durations are in SIMULATED event time
STREAM_WINDOW_DURATION=1 hour
STREAM_WATERMARK_DELAY=15 minutes
# Real-time micro-batch trigger
STREAM_TRIGGER_INTERVAL=10 seconds
SPARK_CHECKPOINT_DIR=/checkpoints
# Max Kafka records per micro-batch (bounds memory when replaying from earliest)
STREAM_MAX_OFFSETS_PER_TRIGGER=20000
# Shuffle partitions for windowed aggregations (fixed in the checkpoint after the first run)
STREAM_SHUFFLE_PARTITIONS=2

# ---------- Batch ----------
LANDING_DIR=/data/landing
# Expense generator --follow: real seconds between checks for completed business dates
EXPENSE_POLL_SECONDS=30
# Reconciliation: event gaps longer than this (SIMULATED minutes) are not counted as
# driving when stream_distance_km is estimated from speed x time
STREAM_DISTANCE_MAX_GAP_MINUTES=30

# ---------- Alert thresholds ----------
# No stream events ingested for this many REAL seconds -> alert
ALERT_NO_DATA_SECONDS=60
# Vehicle idle for this many SIMULATED minutes -> alert
ALERT_IDLE_MINUTES=240
# Daily estimated profit below this -> alert
ALERT_MIN_DAILY_PROFIT=0

# ---------- Profitability thresholds (currency: LKR, Sri Lankan rupees) ----------
# estimated_profit >= PROFITABLE_MIN_PROFIT          -> profitable
# WATCH_MIN_PROFIT <= estimated_profit < PROFITABLE -> watch
# estimated_profit < WATCH_MIN_PROFIT                -> unprofitable
PROFITABLE_MIN_PROFIT=2500
WATCH_MIN_PROFIT=0

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Docker / infrastructure ----------
# UID the application and Airflow containers run as. Set to your `id -u` so files
# written to the bind-mounted data/landing directory are owned by you.
APP_UID=1000
# Host port for PostgreSQL (containers always use postgres:5432)
POSTGRES_HOST_PORT=5432
# KRaft cluster id for the single Kafka node (any 22-char base64 UUID)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Spark build pins. pyspark 3.5.4 is the version Airflow 2.10.5's constraints pin,
# so the runtime and Airflow images run the exact same Spark + connector jars.
PYSPARK_VERSION=3.5.4
POSTGRES_JDBC_VERSION=42.7.13
